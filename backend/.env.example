# Copiar a .env para desarrollo local fuera de Docker
PORT=3000
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=panaderias
POSTGRES_USER=panaderias
POSTGRES_PASSWORD=panaderias

# Firma de los tokens de sesión. Poné un valor largo y aleatorio.
JWT_SECRET=dev-secret-panaderia-cambiar-en-produccion
# Poner en true sólo cuando se sirve por HTTPS (la cookie viaja como Secure).
COOKIE_SECURE=false
