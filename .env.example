# Copiá este archivo a .env (git lo ignora) y poné valores reales:
#   cp .env.example .env
#
# docker-compose.yml lee de acá POSTGRES_PASSWORD y JWT_SECRET; el nombre de la
# base y el usuario van literales en el compose porque no son secretos.
POSTGRES_PASSWORD=cambiame-por-un-valor-local

# Firma de los tokens de sesión. Poné un valor largo y aleatorio.
JWT_SECRET=cambiame-por-un-secreto-largo-y-aleatorio
