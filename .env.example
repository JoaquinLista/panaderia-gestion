# Copiá este archivo a .env (git lo ignora) y poné un valor real:
#   cp .env.example .env
#
# docker-compose.yml solo lee POSTGRES_PASSWORD de acá; el nombre de la base y el
# usuario van literales en el compose porque no son secretos.
POSTGRES_PASSWORD=cambiame-por-un-valor-local

# Firma de las sesiones: un valor largo y al azar. Generalo con:
#   openssl rand -hex 32
JWT_SECRET=cambiame-por-un-valor-largo-y-al-azar-de-64-caracteres

# Primer usuario administrador. Se crea sólo si todavía no hay ningún admin;
# después la contraseña se cambia desde la app y estos valores ya no se usan.
ADMIN_USUARIO=admin
ADMIN_PASSWORD=cambiame-minimo-8-caracteres
