server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # No decir qué versión de Nginx corre (menos pistas para un atacante).
    server_tokens off;

    # Cabeceras de seguridad para todas las respuestas (ver el archivo).
    include /etc/nginx/cabeceras-seguridad.conf;

    # Compresión básica
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Dónde está el backend. Es una plantilla: al arrancar, la imagen oficial de
    # Nginx reemplaza ${BACKEND_URL} y ${NGINX_RESOLVER} con las variables de
    # entorno (valores por defecto en el Dockerfile).
    # - docker compose: http://backend:3000, resuelto con el DNS interno de
    #   Docker (127.0.0.11) en cada request y no al arrancar. Con el nombre escrito
    #   directo en proxy_pass, Nginx se niega a levantar si el backend todavía no
    #   existe ("host not found in upstream").
    # - Azure: http://127.0.0.1:3000, porque los dos contenedores corren juntos.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $backend_api ${BACKEND_URL};

    # Todo lo que llega a /api/ se reenvía al backend.
    # proxy_pass con variable y SIN barra final: se preserva la URI completa
    # (/api/pedidos -> http://backend:3000/api/pedidos).
    location /api/ {
        proxy_pass $backend_api;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # Assets con hash: cache agresivo
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        # Este location agrega una cabecera propia: hay que repetir las de seguridad.
        include /etc/nginx/cabeceras-seguridad.conf;
        try_files $uri =404;
    }

    # SPA fallback: cualquier ruta desconocida devuelve index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
