server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # No decir qué versión de Nginx corre (menos pistas para un atacante).
    server_tokens off;

    # Cabeceras de seguridad para todas las respuestas (ver el archivo).
    include /etc/nginx/cabeceras-seguridad.conf;

    # Compresión básica
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Dónde está el backend. Es una plantilla: al arrancar, la imagen oficial de
    # Nginx reemplaza ${BACKEND_URL} con la variable de entorno (por defecto en
    # el Dockerfile) y ${NGINX_LOCAL_RESOLVERS} con el DNS del contenedor (lo
    # lee de /etc/resolv.conf porque el Dockerfile activa
    # NGINX_ENTRYPOINT_LOCAL_RESOLVERS).
    # - docker compose: http://backend:3000, con el DNS interno de Docker.
    # - Azure: https://<dirección de la app del backend>, con el DNS de Azure.
    # El nombre se resuelve en cada request y no al arrancar: escrito directo en
    # proxy_pass, Nginx se niega a levantar si el backend todavía no existe
    # ("host not found in upstream").
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $backend_api ${BACKEND_URL};

    # Todo lo que llega a /api/ se reenvía al backend.
    # proxy_pass con variable y SIN barra final: se preserva la URI completa
    # (/api/pedidos -> http://backend:3000/api/pedidos).
    location /api/ {
        proxy_pass $backend_api;
        proxy_http_version 1.1;
        # En Azure la entrada del backend elige la app por el nombre: tiene que
        # llegarle el suyo. El de la pantalla va en X-Forwarded-Host.
        proxy_set_header Host              $proxy_host;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Id único de cada request: el backend lo pone en sus logs y lo devuelve.
        proxy_set_header X-Request-Id      $request_id;
        # En Azure el backend tiene dirección pública (la cuenta de estudiante no
        # deja ocultarlo): sólo contesta si llega esta clave, que conocen las dos
        # apps. Vacía (docker compose), Nginx no manda la cabecera.
        proxy_set_header X-Clave-Interna   "${CLAVE_INTERNA}";
        # Con https, el nombre del backend va en el saludo TLS (SNI): la entrada
        # de Azure lo necesita para saber a qué app mandarlo.
        proxy_ssl_server_name on;
        proxy_read_timeout 30s;
    }

    # Assets con hash: cache agresivo
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        # Este location agrega una cabecera propia: hay que repetir las de seguridad.
        include /etc/nginx/cabeceras-seguridad.conf;
        try_files $uri =404;
    }

    # SPA fallback: cualquier ruta desconocida devuelve index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
